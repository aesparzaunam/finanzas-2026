// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}


datasource db {
  provider  = "postgresql"
}


model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String   // Hashed password
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
}

model Account {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      AccountType
  balance   Decimal
  currency  String      @default("USD")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  transactions Transaction[]
}

model Category {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      CategoryType
  icon      String?
  color     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id])
  amount      Decimal
  type        TransactionType
  date        DateTime
  description String?
  
  // MSI Support
  msiPlanId   String?
  msiPlan     MSIPlan?        @relation("MSITransactions", fields: [msiPlanId], references: [id])
  isParent    Boolean         @default(false)  // True if this is the original MSI purchase
  parentId    String?                          // Reference to parent transaction for child MSI records
  parent      Transaction?    @relation("MSIChildren", fields: [parentId], references: [id])
  children    Transaction[]   @relation("MSIChildren")
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model MSIPlan {
  id              String        @id @default(uuid())
  userId          String
  totalAmount     Decimal                      // Original purchase amount
  months          Int                          // Number of installments (3, 6, 12, 18, 24)
  monthlyAmount   Decimal                      // totalAmount / months
  startDate       DateTime                     // First charge date
  description     String?
  accountId       String                       // Credit card account
  categoryId      String?
  status          MSIStatus     @default(ACTIVE)
  paidMonths      Int           @default(0)    // How many have been charged
  
  transactions    Transaction[] @relation("MSITransactions")
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Budget {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id])
  amount          Decimal                              // Monthly/Yearly limit
  period          BudgetPeriod
  enableCarryOver Boolean      @default(true)          // Enable rollover of unused budget
  carryOverAmount Decimal      @default(0)             // Amount carried from previous period
  lastCarryOverAt DateTime?                            // When was carry-over last calculated
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

enum AccountType {
  BANK
  CASH
  CREDIT
  INVESTMENT
  LOAN
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  PAGO_TARJETA    // Credit card payment - does NOT count as expense
  MSI_CHARGE      // Monthly MSI charge - counts as expense
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum BudgetPeriod {
  MONTHLY
  YEARLY
}

enum MSIStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}
